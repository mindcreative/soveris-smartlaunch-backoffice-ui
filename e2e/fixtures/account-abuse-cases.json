  "browserCases": {
    "isolation": "Challenge resources stay in a distinct child with host-only admission cookies",
    "messages": "Foreign origin source nonce and open messages cannot enable signup",
    "retry": "Blocked provider requires deliberate retry and preserves typed fields",
    "denial": "A recoverable mutation denial clears challenge without replay or account effects",
    "documents": "Signup document seals before login and reloads before reentry and variants",
    "history": "Back forward and restored signup documents retain the frame policy boundary",
    "mobile": "Challenge keyboard controls fit a 320 pixel layout without accessibility violations",
    "proxy": "Built proxy rejects method query suffix encoded and oversized admission aliases"
  }
