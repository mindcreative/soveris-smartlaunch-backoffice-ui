FROM node:22-alpine AS configuration
WORKDIR /challenge
ARG ACCOUNT_ORIGIN
ARG CHALLENGE_ORIGIN
COPY challenge/nginx.conf.template ./nginx.conf.template
COPY scripts/render-challenge-nginx.mjs ./render-challenge-nginx.mjs
RUN node render-challenge-nginx.mjs nginx.conf.template /tmp/challenge-nginx.conf /tmp/challenge-config.js "$ACCOUNT_ORIGIN" "$CHALLENGE_ORIGIN"

FROM nginx:1.28.0-alpine@sha256:30f1c0d78e0ad60901648be663a710bdadf19e4c10ac6782c235200619158284
COPY challenge/index.html challenge/challenge.js /usr/share/nginx/html/
COPY --from=configuration /tmp/challenge-config.js /usr/share/nginx/html/challenge-config.js
COPY --from=configuration /tmp/challenge-nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
